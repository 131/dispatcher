#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
mkdir -p output/go
for arch in 386 amd64; do
  suffix=""
  if [[ "$arch" == amd64 ]]; then suffix="_x64"; fi
  for kind in cmd win; do
    flags='-s -w'
    if [[ "$kind" == win ]]; then flags="$flags -H windowsgui -X main.gui=true"; fi
    GOOS=windows GOARCH="$arch" CGO_ENABLED=0 go build -trimpath -ldflags "$flags" \
      -o "output/go/dispatcher_go_${kind}${suffix}.exe" ./cmd/dispatcher-go
  done
done
