#!/bin/bash

set -eu

output_dir=output
out_win_x86=$output_dir/dispatcher_win.exe
out_cmd_x86=$output_dir/dispatcher_cmd.exe
out_win_x64=$output_dir/dispatcher_win_x64.exe
out_cmd_x64=$output_dir/dispatcher_cmd_x64.exe


dobuild=
dosign=
dotest=

while test $# -gt 0
do
  case "$1" in
    --build) dobuild=true
        ;;
    --sign) dosign=true
        ;;
    --test) dotest=true
        ;;
    --*) echo "bad option $1"
        ;;
    *) echo "argument $1"
        ;;
  esac
  shift
done

sign() {
  FILE_IN="$1"
  FILE_OUT="$FILE_IN.signed"

  echo "Signing $FILE_IN"

  args=(-s -X PUT --data-binary @-)
  args=("${args[@]}"  -D -)
  args=("${args[@]}" -o "$FILE_OUT")
#  args=("${args[@]}" \
#      -H 'x-container: ' \
#      -H 'x-pin:  ' \
#      -H 'x-thumbprint: ' \
#      -H 'x-timestamp:  http://timestamp.digicert.com' \
#  )


  response=$(cat "$FILE_IN" | curl "${args[@]}" $SIGNING_SERVER | sed 's/\r$//' )

  if echo "$response" | grep -qe "HTTP/1.. 200 " ; then
    mv "$FILE_OUT" "$FILE_IN"
    echo "$FILE_IN successfully signed."
  else
    echo  "Could not sign $FILE_IN"
    exit 1
  fi
}

if [[ ! -z "$dobuild" ]] ; then
  echo "Running application build"

  runtime_dir="${SystemRoot:-C:\Windows}\\Microsoft.NET\\Framework\\v4.0.30319"
  compiler="$runtime_dir\\csc.exe"
  framework="${NET48_REFERENCE_ASSEMBLIES:-}"
  if [[ -z "$framework" ]] ; then
    framework='C:\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8'
  fi
  if command -v wslpath >/dev/null; then
    compiler=$(wslpath "$compiler")
    runtime_dir=$(wslpath "$runtime_dir")
    reference_dir=$(wslpath "$framework")
  elif command -v cygpath >/dev/null; then
    compiler=$(cygpath "$compiler")
    runtime_dir=$(cygpath "$runtime_dir")
    reference_dir=$(cygpath "$framework")
  else
    compiler=csc.exe
    reference_dir="$framework"
  fi
  if [[ -z "${NET48_REFERENCE_ASSEMBLIES:-}" && ! -f "$reference_dir/mscorlib.dll" ]]; then
    reference_dir="$runtime_dir"
  fi
  if [[ ! -f "$reference_dir/mscorlib.dll" ]] ; then
    echo "Cannot find .NET Framework assemblies in: $reference_dir" >&2
    exit 1
  fi
  if command -v wslpath >/dev/null; then
    framework=$(wslpath -w "$reference_dir")
  elif command -v cygpath >/dev/null; then
    framework=$(cygpath -w "$reference_dir")
  else
    framework="$reference_dir"
  fi
  echo "Using .NET Framework assemblies: $framework"
  mkdir -p "$output_dir"

  args=(/nologo /noconfig /nostdlib+ /filealign:512 /utf8output)
  for assembly in mscorlib System System.Core System.Xml System.ServiceProcess System.Management; do
    args+=("/reference:$framework\\$assembly.dll")
  done
  files=(src\\Utils\\Job.cs src\\Utils\\Kernel32.cs src\\Utils\\PackagedApplication.cs src\\Utils\\PackagePipe.cs src\\Program.cs src\\Properties\\AssemblyInfo.cs src\\Utils\\ProcessExtensions.cs src\\Utils\\ParentProcessUtilities.cs src\\Utils\\UWFManagement.cs)

  MSYS2_ARG_CONV_EXCL='*' "$compiler" "${args[@]}" /platform:x86 /define:DISPACHER_WIN /target:winexe /out:$out_win_x86 "${files[@]}"
  MSYS2_ARG_CONV_EXCL='*' "$compiler" "${args[@]}" /platform:x86                       /target:exe    /out:$out_cmd_x86 "${files[@]}"
  MSYS2_ARG_CONV_EXCL='*' "$compiler" "${args[@]}" /platform:x64 /define:DISPACHER_WIN /target:winexe /out:$out_win_x64 "${files[@]}"
  MSYS2_ARG_CONV_EXCL='*' "$compiler" "${args[@]}" /platform:x64                       /target:exe    /out:$out_cmd_x64 "${files[@]}"

  mkdir -p "$output_dir/examples"
  cp "$out_win_x64" "$output_dir/examples/autolock.exe"
  cp examples/autolock.exe.config "$output_dir/examples/autolock.exe.config"
fi

if [[ ! -z "$dosign" ]] ; then
  # Signing is the only build step that needs credentials.
  if [[ -f .env ]] ; then
    export $(cat .env | xargs)
  fi
  if [[ -z "${SIGNING_SERVER:-}" ]] ; then
    echo "No signing server defined";
    exit 1
  fi

  echo "Signing binaries"

  sign $out_win_x86
  sign $out_cmd_x86
  sign $out_win_x64
  sign $out_cmd_x64
fi


if [[ ! -z "$dotest" ]] ; then
  echo "Running test suite"

  cmd.exe /c npm install
  cmd.exe /c npm test
fi
